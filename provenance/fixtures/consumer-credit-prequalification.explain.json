    "criteria": [
        {
            "criterion_id": "adverse_history_check",
            "group": "adverse_history_check",
            "title": "No adverse credit history",
            "rule_text": "credit.has_adverse_history equals false",
            "source_refs": [
                "src_VMBVZPVvST8#item_000003"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "src_VMBVZPVvST8#item_000003",
                    "title": "Consumer Credit Pre-Qualification Rules 2025 (synthetic regulation)",
                    "authority": "Aethis",
                    "url": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/consumer-credit-prequalification/sources/source.md",
                    "locator": "Section 3(1)",
                    "source_version": "aethis-examples@main",
                    "source_date": "2026-04-07",
                    "content_digest": "sha256:31cbcdf2974d497426f12c4fcec3e81705a048d2df7b475869fb2649cb4b01ab",
                    "licence": "MIT",
                    "verified_at": "2026-10-23T14:41:48.507000Z",
                    "quote": {
                        "exact": "An applicant with an adverse credit history must be refused without consideration of any other requirement under these rules.",
                        "prefix": null,
                        "suffix": null
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/consumer-credit-prequalification/sources/source.md#:~:text=An%20applicant%20with%20an%20adverse%20credit%20history%20must%20be%20refused%20without%20consideration%20of%20any%20other%20requirement%20under%20these%20rules.",
                    "snapshot": "sha256:31cbcdf2974d497426f12c4fcec3e81705a048d2df7b475869fb2649cb4b01ab"
                }
            ]
        },
        {
            "criterion_id": "employment_check",
            "group": "employment_check",
            "title": "Eligible employment status",
            "rule_text": "credit.employment_status is one of \"employed\", \"self_employed\", or \"retired\"",
            "source_refs": [
                "src_VMBVZPVvST8#item_000004"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "src_VMBVZPVvST8#item_000004",
                    "title": "Consumer Credit Pre-Qualification Rules 2025 (synthetic regulation)",
                    "authority": "Aethis",
                    "url": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/consumer-credit-prequalification/sources/source.md",
                    "locator": "Section 4(1)",
                    "source_version": "aethis-examples@main",
                    "source_date": "2026-04-07",
                    "content_digest": "sha256:31cbcdf2974d497426f12c4fcec3e81705a048d2df7b475869fb2649cb4b01ab",
                    "licence": "MIT",
                    "verified_at": "2026-10-23T14:41:48.535000Z",
                    "quote": {
                        "exact": "The applicant must be in one of the following employment categories\u2014 (a) employed (full-time or part-time); (b) self-employed (trading not less than 2 years); (c) retired (receiving pension income).",
                        "prefix": null,
                        "suffix": null
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/consumer-credit-prequalification/sources/source.md#:~:text=The%20applicant%20must%20be%20in%20one%20of%20the%20following%20employment%20categories%E2%80%94%20%28a%29%20employed%20%28full-time%20or%20part-time%29%3B%20%28b%29%20self-employed%20%28trading%20not%20less%20than%202%20years%29%3B%20%28c%29%20retired%20%28receiving%20pension%20income%29.",
                    "snapshot": "sha256:31cbcdf2974d497426f12c4fcec3e81705a048d2df7b475869fb2649cb4b01ab"
                }
            ]
        },
        {
            "criterion_id": "income_route_a",
            "group": "income_check",
            "title": "Income threshold \u2014 Route A (sole income)",
            "rule_text": "credit.gross_annual_income is at least 15000",
            "source_refs": [
                "src_VMBVZPVvST8#item_000005"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "src_VMBVZPVvST8#item_000005",
                    "title": "Consumer Credit Pre-Qualification Rules 2025 (synthetic regulation)",
                    "authority": "Aethis",
                    "url": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/consumer-credit-prequalification/sources/source.md",
                    "locator": "Section 5(1)",
                    "source_version": "aethis-examples@main",
                    "source_date": "2026-04-07",
                    "content_digest": "sha256:31cbcdf2974d497426f12c4fcec3e81705a048d2df7b475869fb2649cb4b01ab",
                    "licence": "MIT",
                    "verified_at": "2026-10-23T14:41:48.563000Z",
                    "quote": {
                        "exact": "(a) **Route A (sole income):** the applicant's gross annual income is not less than GBP 15,000; or (b) **Route B (joint income):** the combined gross annual income of the applicant and a joint applicant is not less than GBP 20,000.",
                        "prefix": null,
                        "suffix": null
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/consumer-credit-prequalification/sources/source.md#:~:text=%28a%29%20%2A%2ARoute%20A%20%28sole%20income%29%3A%2A%2A%20the%20applicant%27s%20gross%20annual%20income%20is%20not%20less%20than%20GBP%2015%2C000%3B%20or%20%28b%29%20%2A%2ARoute%20B%20%28joint%20income%29%3A%2A%2A%20the%20combined%20gross%20annual%20income%20of%20the%20applicant%20and%20a%20joint%20applicant%20is%20not%20less%20than%20GBP%2020%2C000.",
                    "snapshot": "sha256:31cbcdf2974d497426f12c4fcec3e81705a048d2df7b475869fb2649cb4b01ab"
                }
            ]
        },
        {
            "criterion_id": "income_route_b",
            "group": "income_check",
            "title": "Income threshold \u2014 Route B (joint income)",
            "rule_text": "( AND credit.has_joint_applicant equals true AND Operator.PLUS(credit.gross_annual_income, credit.joint_annual_income) is at least 20000)",
            "source_refs": [
