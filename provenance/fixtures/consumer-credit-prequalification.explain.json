        {
            "criterion_id": "credit_score_secured",
            "group": "credit_score_check",
            "title": "Credit score requirement \u2014 secured facility",
            "rule_text": "( AND credit.product_type equals \"secured\" AND credit.credit_score_band is one of \"fair\", \"good\", or \"excellent\")",
            "source_refs": [
                "src_VMBVZPVvST8#item_000007"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "src_VMBVZPVvST8#item_000007",
                    "title": "Consumer Credit Pre-Qualification Rules 2025 (synthetic regulation)",
                    "authority": "Aethis",
