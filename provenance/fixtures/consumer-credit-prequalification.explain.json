                    "source_version": "aethis-examples@main",
                    "source_date": "2026-04-07",
                    "content_digest": "sha256:31cbcdf2974d497426f12c4fcec3e81705a048d2df7b475869fb2649cb4b01ab",
                    "licence": "MIT",
                    "verified_at": "2026-10-23T14:41:48.623000Z",
                    "quote": {
                        "exact": "(a) for a **secured** facility: the credit score band must be \"fair\", \"good\", or \"excellent\"; (b) for an **unsecured** facility: the credit score band must be \"good\" or \"excellent\".",
                        "prefix": null,
                        "suffix": null
                    },
                    "media_type": "text",
