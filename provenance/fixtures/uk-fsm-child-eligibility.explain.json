                    "verified_at": "2026-10-23T15:03:14.850000Z",
                    "quote": {
                        "exact": "Compulsory school age begins at the start of the term following a child's fifth birthday, but in practice the provision applies from the start of the Reception year (age 4\u20135).\n**Relevant school** means\u2014 (a) a school maintained by a local authority in England; (b) an Academy; (c) a non-maintained special school; (d) a pupil referral unit.\nIndependent schools (fee-paying) and home-educated children are not within scope of this provision.",
                        "prefix": null,
                        "suffix": null
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/ed33765e60fcdb8e713e80e631a517c852e6acfe/uk-free-school-meals/sections/A_child_eligibility/sources/education_act_1996_s512.md#:~:text=Compulsory%20school%20age%20begins%20at%20the%20start%20of%20the%20term%20following%20a%20child%27s%20fifth%20birthday%2C%20but%20in%20practice%20the%20provision%20applies%20from%20the%20start%20of%20the%20Reception%20year%20%28age%204%E2%80%935%29.%20%2A%2ARelevant%20school%2A%2A%20means%E2%80%94%20%28a%29%20a%20school%20maintained%20by%20a%20local%20authority%20in%20England%3B%20%28b%29%20an%20Academy%3B%20%28c%29%20a%20non-maintained%20special%20school%3B%20%28d%29%20a%20pupil%20referral%20unit.%20Independent%20schools%20%28fee-paying%29%20and%20home-educated%20children%20are%20not%20within%20scope%20of%20this%20provision.",
                    "snapshot": "sha256:9917d94b8454c98767479cae3c4a24c7743d66296fdc1f52fce02060ac350ee4"
                }
