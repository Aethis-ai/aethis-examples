        {
            "criterion_id": "species_eligible",
            "group": "species_eligibility",
            "title": "Species eligibility",
            "rule_text": "NOT (space.crew.species equals \"Vogon\")",
            "source_refs": [
                "source.md#source/Section 3: Species eligibility"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "source.md#source/Section 3: Species eligibility",
                    "title": "Spacecraft Crew Certification Act 2049 (synthetic statute)",
                    "authority": "Aethis",
                    "url": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/spacecraft-crew-certification/sources/source.md",
                    "locator": "Section 3(1)",
                    "source_version": "aethis-examples@main",
                    "source_date": "2026-05-17",
                    "content_digest": "sha256:303eed8e4cc051601e46f72be2531a428ea29d254df8e9226d150e5a2e820113",
                    "licence": "MIT",
                    "verified_at": "2026-07-28T15:50:24.010875Z",
                    "quote": {
                        "exact": "An applicant for crew certification must be of an eligible species.",
                        "prefix": null,
                        "suffix": "(2) A Vogon national is not an eligible species"
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/spacecraft-crew-certification/sources/source.md#:~:text=An%20applicant%20for%20crew%20certification%20must%20be%20of%20an%20eligible%20species.,-%282%29%20A%20Vogon%20national%20is%20not%20an%20eligible%20species",
                    "snapshot": "sha256:303eed8e4cc051601e46f72be2531a428ea29d254df8e9226d150e5a2e820113"
                }
            ]
        },
        {
            "criterion_id": "flight_readiness_met",
            "group": "flight_readiness",
            "title": "Flight readiness met (Section 4)",
            "rule_text": "( AND space.crew.flight_hours is at least 500 AND space.crew.has_pilot_license equals true)",
            "source_refs": [
                "source.md#source/Section 4: Flight readiness"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "source.md#source/Section 4: Flight readiness",
                    "title": "Spacecraft Crew Certification Act 2049 (synthetic statute)",
                    "authority": "Aethis",
                    "url": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/spacecraft-crew-certification/sources/source.md",
                    "locator": "Section 4(1)(a)-(b)",
                    "source_version": "aethis-examples@main",
                    "source_date": "2026-05-17",
                    "content_digest": "sha256:303eed8e4cc051601e46f72be2531a428ea29d254df8e9226d150e5a2e820113",
                    "licence": "MIT",
                    "verified_at": "2026-07-28T15:50:24.034278Z",
                    "quote": {
                        "exact": "the applicant has accumulated not fewer than 500 flight hours; and (b) the applicant holds a valid pilot licence issued or recognised by the Authority.",
                        "prefix": null,
                        "suffix": null
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/spacecraft-crew-certification/sources/source.md#:~:text=the%20applicant%20has%20accumulated%20not%20fewer%20than%20500%20flight%20hours%3B%20and%20%28b%29%20the%20applicant%20holds%20a%20valid%20pilot%20licence%20issued%20or%20recognised%20by%20the%20Authority.",
                    "snapshot": "sha256:303eed8e4cc051601e46f72be2531a428ea29d254df8e9226d150e5a2e820113"
                }
            ]
        },
        {
            "criterion_id": "flight_readiness_exempt_age",
            "group": "flight_readiness",
            "title": "Flight readiness exempt \u2014 age (Section 6, age route)",
            "rule_text": "( AND space.crew.age is at least 60 AND NOT (space.mission.type equals \"orbital\"))",
            "source_refs": [
                "source.md#source/Section 6: Age exemption from flight readiness"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "source.md#source/Section 6: Age exemption from flight readiness",
                    "title": "Spacecraft Crew Certification Act 2049 (synthetic statute)",
                    "authority": "Aethis",
                    "url": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/spacecraft-crew-certification/sources/source.md",
                    "locator": "Section 6(1)-(3)",
                    "source_version": "aethis-examples@main",
                    "source_date": "2026-05-17",
                    "content_digest": "sha256:303eed8e4cc051601e46f72be2531a428ea29d254df8e9226d150e5a2e820113",
                    "licence": "MIT",
                    "verified_at": "2026-07-28T15:50:24.110425Z",
                    "quote": {
                        "exact": "(1) Subject to subsection (2), an applicant aged 60 or over is exempt from the flight readiness requirement in Section 4. (2) The exemption under subsection (1) does not apply where the mission type is \"orbital\", unless subsection (3) applies. (3) An applicant who has accumulated not fewer than 1000 flight hours is exempt from Section 4 regardless of mission type, notwithstanding subsection (2).",
                        "prefix": null,
                        "suffix": null
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/main/spacecraft-crew-certification/sources/source.md#:~:text=%281%29%20Subject%20to%20subsection%20%282%29%2C%20an%20applicant%20aged%2060%20or%20over%20is%20exempt%20from%20the%20flight%20readiness%20requirement%20in%20Section%204.%20%282%29%20The%20exemption%20under%20subsection%20%281%29%20does%20not%20apply%20where%20the%20mission%20type%20is%20%22orbital%22%2C%20unless%20subsection%20%283%29%20applies.%20%283%29%20An%20applicant%20who%20has%20accumulated%20not%20fewer%20than%201000%20flight%20hours%20is%20exempt%20from%20Section%204%20regardless%20of%20mission%20type%2C%20notwithstanding%20subsection%20%282%29.",
                    "snapshot": "sha256:303eed8e4cc051601e46f72be2531a428ea29d254df8e9226d150e5a2e820113"
                }
            ]
        },
