        {
            "criterion_id": "species_eligible",
            "group": "species_eligibility",
            "title": "Species eligibility",
            "rule_text": "NOT (space.crew.species equals \"Vogon\")",
            "source_refs": [
                "src_4BavI7nX3-Q#item_000003"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "src_4BavI7nX3-Q#item_000003",
                    "title": "Spacecraft Crew Certification Act 2049 (synthetic statute)",
                    "authority": "Aethis",
                    "url": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/6732cffbfbcd9960a89c980a05d7898797f1dbab/spacecraft-crew-certification/sources/source.md",
                    "locator": "Section 3(1)",
                    "source_version": "aethis-examples@main",
                    "source_date": "2026-10-22",
                    "content_digest": "sha256:7ecaece8f9a3472743ab90c4ae4938705cad7661a8bc05bdfbe237b96b59e61d",
                    "licence": "MIT",
                    "verified_at": "2026-10-23T14:50:20.018000Z",
                    "quote": {
                        "exact": "An applicant for crew certification must be of an eligible species.",
                        "prefix": null,
                        "suffix": "(2) A Vogon national is not an eligible species"
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/6732cffbfbcd9960a89c980a05d7898797f1dbab/spacecraft-crew-certification/sources/source.md#:~:text=An%20applicant%20for%20crew%20certification%20must%20be%20of%20an%20eligible%20species.,-%282%29%20A%20Vogon%20national%20is%20not%20an%20eligible%20species",
                    "snapshot": "sha256:7ecaece8f9a3472743ab90c4ae4938705cad7661a8bc05bdfbe237b96b59e61d"
                }
            ]
        },
        {
            "criterion_id": "flight_readiness_met",
            "group": "flight_readiness",
            "title": "Flight readiness met (Section 4)",
            "rule_text": "( AND space.crew.flight_hours is at least 500 AND space.crew.has_pilot_license equals true)",
            "source_refs": [
                "src_4BavI7nX3-Q#item_000004"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "src_4BavI7nX3-Q#item_000004",
                    "title": "Spacecraft Crew Certification Act 2049 (synthetic statute)",
                    "authority": "Aethis",
                    "url": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/6732cffbfbcd9960a89c980a05d7898797f1dbab/spacecraft-crew-certification/sources/source.md",
                    "locator": "Section 4(1)(a)-(b)",
                    "source_version": "aethis-examples@main",
                    "source_date": "2026-10-22",
                    "content_digest": "sha256:7ecaece8f9a3472743ab90c4ae4938705cad7661a8bc05bdfbe237b96b59e61d",
                    "licence": "MIT",
                    "verified_at": "2026-10-23T14:50:20.055000Z",
                    "quote": {
                        "exact": "the applicant has accumulated not fewer than 500 flight hours; and (b) the applicant holds a valid pilot licence issued or recognised by the Authority.",
                        "prefix": null,
                        "suffix": null
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/6732cffbfbcd9960a89c980a05d7898797f1dbab/spacecraft-crew-certification/sources/source.md#:~:text=the%20applicant%20has%20accumulated%20not%20fewer%20than%20500%20flight%20hours%3B%20and%20%28b%29%20the%20applicant%20holds%20a%20valid%20pilot%20licence%20issued%20or%20recognised%20by%20the%20Authority.",
                    "snapshot": "sha256:7ecaece8f9a3472743ab90c4ae4938705cad7661a8bc05bdfbe237b96b59e61d"
                }
            ]
        },
        {
            "criterion_id": "flight_readiness_exempt_age",
            "group": "flight_readiness",
            "title": "Flight readiness exempt \u2014 age (Section 6, age route)",
            "rule_text": "( AND space.crew.age is at least 60 AND NOT (space.mission.type equals \"orbital\"))",
            "source_refs": [
                "src_4BavI7nX3-Q#item_000007"
            ],
            "source_references": [
                {
                    "schema_version": 1,
                    "source_id": "src_4BavI7nX3-Q#item_000007",
                    "title": "Spacecraft Crew Certification Act 2049 (synthetic statute)",
                    "authority": "Aethis",
                    "url": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/6732cffbfbcd9960a89c980a05d7898797f1dbab/spacecraft-crew-certification/sources/source.md",
                    "locator": "Section 6(1)-(4)",
                    "source_version": "aethis-examples@main",
                    "source_date": "2026-10-22",
                    "content_digest": "sha256:7ecaece8f9a3472743ab90c4ae4938705cad7661a8bc05bdfbe237b96b59e61d",
                    "licence": "MIT",
                    "verified_at": "2026-10-23T14:50:20.160000Z",
                    "quote": {
                        "exact": "(1) Subject to subsection (2), an applicant aged 60 or over is exempt from the flight readiness requirement in Section 4. (2) The exemption under subsection (1) does not apply where the mission type is \"orbital\", unless subsection (3) applies. (3) An applicant who has accumulated not fewer than 1000 flight hours is exempt from Section 4 regardless of mission type, notwithstanding subsection (2). (4) For the avoidance of doubt\u2014 (a) an applicant aged 60 or over on a suborbital or lunar mission is exempt from Section 4 under subsection (1); (b) an applicant aged 60 or over on an orbital mission is NOT exempt from Section 4, unless the applicant has 1000+ flight hours under subsection (3); (c) an applicant aged 59 or under must satisfy Section 4, unless the applicant qualifies under subsection (3).",
                        "prefix": null,
                        "suffix": null
                    },
                    "media_type": "text",
                    "deep_link": "https://raw.githubusercontent.com/Aethis-ai/aethis-examples/6732cffbfbcd9960a89c980a05d7898797f1dbab/spacecraft-crew-certification/sources/source.md#:~:text=%281%29%20Subject%20to%20subsection%20%282%29%2C%20an%20applicant%20aged%2060%20or%20over%20is%20exempt%20from%20the%20flight%20readiness%20requirement%20in%20Section%204.%20%282%29%20The%20exemption%20under%20subsection%20%281%29%20does%20not%20apply%20where%20the%20mission%20type%20is%20%22orbital%22%2C%20unless%20subsection%20%283%29%20applies.%20%283%29%20An%20applicant%20who%20has%20accumulated%20not%20fewer%20than%201000%20flight%20hours%20is%20exempt%20from%20Section%204%20regardless%20of%20mission%20type%2C%20notwithstanding%20subsection%20%282%29.%20%284%29%20For%20the%20avoidance%20of%20doubt%E2%80%94%20%28a%29%20an%20applicant%20aged%2060%20or%20over%20on%20a%20suborbital%20or%20lunar%20mission%20is%20exempt%20from%20Section%204%20under%20subsection%20%281%29%3B%20%28b%29%20an%20applicant%20aged%2060%20or%20over%20on%20an%20orbital%20mission%20is%20NOT%20exempt%20from%20Section%204%2C%20unless%20the%20applicant%20has%201000%2B%20flight%20hours%20under%20subsection%20%283%29%3B%20%28c%29%20an%20applicant%20aged%2059%20or%20under%20must%20satisfy%20Section%204%2C%20unless%20the%20applicant%20qualifies%20under%20subsection%20%283%29.",
                    "snapshot": "sha256:7ecaece8f9a3472743ab90c4ae4938705cad7661a8bc05bdfbe237b96b59e61d"
                }
            ]
        },
